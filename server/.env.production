# ============================================
# ARK CODE Server — 生产环境变量
# 部署时复制此文件为 .env 并填入真实值
# ============================================

# 数据库 — Neon PostgreSQL
# 格式: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://arkcode:YOUR_PASSWORD@ep-xxx.us-east-2.aws.neon.tech/arkcode?sslmode=require"

# 数据库直接连接（Prisma Migrate 用，不含 pooler）
# DIRECT_URL="postgresql://arkcode:YOUR_PASSWORD@ep-xxx.us-east-2.aws.neon.tech/arkcode?sslmode=require"

# Redis — Upstash
REDIS_URL="redis://default:YOUR_TOKEN@upstash-redis-xxx.upstash.io:6379"

# JWT — 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_GENERATE_RANDOM_64_BYTES_HEX"
JWT_EXPIRES_IN="7d"

# 服务
PORT=3000
HOST="0.0.0.0"

# 前端（部署到 Vercel 后替换为真实域名）
CORS_ORIGIN="https://arkcode.vercel.app"

# 环境
NODE_ENV="production"
